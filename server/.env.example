PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_NAME=OrcaXCare

# Auth 1.0 — opaque Token stored in DB (no JWT)

# === Email (SMTP) — bắt buộc để gửi link verify / reset password ===
# Gmail: bật 2FA → tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=truongtn.dev@gmail.com
SMTP_PASS=your-app-password-16-chars
MAIL_FROM=OrcaXCare <truongtn.dev@gmail.com>

# === Chọn 1 cách kết nối DB ===

# (A) Dev nhanh — không cần Atlas, không cần cài MongoDB (khuyến nghị khi bị lỗi IP)
MONGODB_URI=memory

# (B) MongoDB local (cài MongoDB Community trước)
# MONGODB_URI=mongodb://127.0.0.1:27017/orcaxcare

# (C) MongoDB Atlas (whitelist IP 0.0.0.0/0 trên cloud.mongodb.com)
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.../orcaxcare?retryWrites=true&w=majority

# Tự seed admin + doctors khi dùng memory DB
AUTO_SEED=true
