PORT=5000
CLIENT_ORIGIN=http://localhost:5173
APP_NAME=OrcaXCare

# Auth 1.0 — opaque Token stored in DB (no JWT)

# === Email (SMTP) — bắt buộc để gửi link verify / reset password ===
# Mail GỬI (From): truongtn.dev@gmail.com — tài khoản Gmail + App Password bên dưới
# Mail NHẬN (To): email user đăng ký trên app (vd. thanhtruongblog@gmail.com, fpt.edu.vn, ...)
# Gmail: bật 2FA → tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=truongtn.dev@gmail.com
SMTP_PASS=your-app-password-16-chars
MAIL_FROM=OrcaXCare <truongtn.dev@gmail.com>

# === Chọn 1 cách kết nối DB ===

# (A) Dev nhanh — không cần Atlas, không cần cài MongoDB (khuyến nghị khi bị lỗi IP)
# MONGODB_URI=memory

# (B) MongoDB local (cài MongoDB Community trước)
# MONGODB_URI=mongodb://127.0.0.1:27017/orcaxcare

# (C) MongoDB Atlas (whitelist IP 0.0.0.0/0 trên cloud.mongodb.com)
MONGODB_USER=admin_orcaxcare
MONGODB_PASSWORD=your-db-password
MONGODB_HOST=admin.fl2s791.mongodb.net
MONGODB_DB=orcaxcare
# Hoặc dùng 1 dòng:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@admin.fl2s791.mongodb.net/orcaxcare?retryWrites=true&w=majority&appName=OrcaXCare

# Tự seed admin + doctors khi dùng memory DB
AUTO_SEED=true

# === Cloudinary (avatar / medical images) ===
# Dashboard: https://console.cloudinary.com/ → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Uploads go through POST /api/upload/image (signed server upload).
# Optional legacy client preset — not required when API key/secret are set:
# CLOUDINARY_UPLOAD_PRESET=orcaxcare_unsigned

# === PayOS wallet top-up ===
# Dashboard: https://my.payos.vn/ → channel credentials
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_MOCK=false   # WDP301/demo: MUST stay false — real PayOS VietQR only
# Webhook URL (đăng ký PayOS dashboard): {API_PUBLIC_ORIGIN}/api/payments/payos/webhook
# WALLET_MIN_TOPUP=10000
# WALLET_MAX_TOPUP=50000000
# API_PUBLIC_ORIGIN=http://localhost:5000

# === VNPay wallet top-up ===
# Đăng ký sandbox → VNPay gửi email TMN + Hash Secret
# Merchant admin: https://sandbox.vnpayment.vn/merchantv2/
# IPN URL (đăng ký với VNPay): {API_PUBLIC_ORIGIN}/api/payments/vnpay/ipn
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_MOCK=true
# VNPAY_ENV=sandbox

# === SePay wallet top-up ===
# Sandbox: https://my.sepay.vn/ → Payment Gateway → MERCHANT ID (SP-TEST-...) + SECRET KEY
# Production: SP-LIVE-... + spsk_live_... — tự nhận production khi MERCHANT ID chứa LIVE
# IPN URL (đăng ký SePay dashboard): {API_PUBLIC_ORIGIN}/api/payments/sepay/ipn
# Production cần API_PUBLIC_ORIGIN HTTPS công khai (ngrok) cho callback/IPN
# SEPAY_MERCHANT_ID=
# SEPAY_SECRET_KEY=
# SEPAY_MOCK=false   # WDP301/demo: MUST stay false — real SePay sandbox only
# SEPAY_ENV=production
# SEPAY_CHECKOUT_URL=https://pay.sepay.vn/v1/checkout/init
