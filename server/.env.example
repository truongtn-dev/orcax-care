PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Atlas: copy URI, add /<db>?retryWrites=true&w=majority — chỉ điền thật trong `.env`, không commit.
MONGODB_URI=mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/<DB_NAME>?retryWrites=true&w=majority&appName=OrcaXCare
