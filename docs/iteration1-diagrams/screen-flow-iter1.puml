@startuml OrcaXCare_Iter1_ScreenFlow
title Iteration 1 — Screen Flow (OrcaXCare)
skinparam shadowing false
skinparam defaultTextAlignment center

rectangle "Public Portal" {
  (Portal Home) as HOME
  (Login) as LOGIN
  (Register) as REG
  (Verify Email) as VERIFY
  (Forgot Password) as FORGOT
  (Search Doctors) as SEARCH
  (Doctor Public Profile) as DPROF
}

rectangle "Patient (logged in)" {
  (Patient Dashboard) as PDASH
  (View Own Profile) as PPROF
  (Update Own Profile) as PEDIT
  (Upload Avatar) as AVATAR
  (Change Password) as CPWD
}

rectangle "Admin (logged in)" {
  (Admin Dashboard) as ADASH
  (Accounts List) as ALIST
  (Account Detail) as ADET
  (Create/Update Account) as AFORM
  (Specialties List) as SLIST
  (Create/Update Specialty) as SFORM
  (Departments List) as DLIST
  (Doctors List Admin) as DOCLIST
  (Create/Update Doctor) as DOCFORM
  (Patients List) as PLIST
}

HOME --> LOGIN
HOME --> REG
HOME --> SEARCH
LOGIN --> PDASH : patient
LOGIN --> ADASH : admin
REG --> VERIFY : email link
FORGOT --> LOGIN
SEARCH --> DPROF
PDASH --> PPROF
PPROF --> PEDIT
PPROF --> AVATAR
PDASH --> CPWD
ADASH --> ALIST
ALIST --> ADET
ADET --> AFORM
ADASH --> SLIST
SLIST --> SFORM
ADASH --> DLIST
ADASH --> DOCLIST
DOCLIST --> DOCFORM
ADASH --> PLIST

@enduml
