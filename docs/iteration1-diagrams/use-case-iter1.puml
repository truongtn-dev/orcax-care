@startuml OrcaXCare_Iter1_UseCases
left to right direction
skinparam packageStyle rectangle

actor Guest
actor Patient
actor Admin

rectangle "OrcaXCare — Iteration 1" {
  usecase "View Portal Home\n(ORCX-036)" as UC_HOME
  usecase "Login\n(ORCX-001)" as UC_LOGIN
  usecase "Register Account\n(ORCX-003)" as UC_REG
  usecase "Verify Email\n(ORCX-005)" as UC_VERIFY
  usecase "Forgot Password\n(ORCX-004)" as UC_FORGOT
  usecase "Search Doctors\n(ORCX-038)" as UC_SEARCH
  usecase "View Doctor Profile\n(ORCX-031)" as UC_DVIEW

  usecase "Logout\n(ORCX-002)" as UC_LOGOUT
  usecase "Manage Own Profile\n(ORCX-039)" as UC_PROFILE
  usecase "Patient Dashboard\n(ORCX-139)" as UC_PDASH

  usecase "Manage Accounts\n(ORCX-008)" as UC_ACC
  usecase "Manage Specialties\n(ORCX-015)" as UC_SPEC
  usecase "Manage Departments\n(ORCX-020)" as UC_DEPT
  usecase "Manage Doctors\n(ORCX-028)" as UC_DOC
  usecase "Manage Patients\n(ORCX-042)" as UC_PAT
  usecase "Admin Dashboard\n(ORCX-140)" as UC_ADASH
}

Guest --> UC_HOME
Guest --> UC_LOGIN
Guest --> UC_REG
Guest --> UC_FORGOT
Guest --> UC_SEARCH
Guest --> UC_DVIEW

Patient --> UC_LOGOUT
Patient --> UC_PROFILE
Patient --> UC_PDASH
Patient --> UC_SEARCH
Patient --> UC_DVIEW

Admin --> UC_LOGOUT
Admin --> UC_ACC
Admin --> UC_SPEC
Admin --> UC_DEPT
Admin --> UC_DOC
Admin --> UC_PAT
Admin --> UC_ADASH

UC_REG ..> UC_VERIFY : <<include>>
UC_PROFILE ..> UC_LOGIN : <<include>>
UC_ACC ..> UC_LOGIN : <<include>>
UC_SPEC ..> UC_LOGIN : <<include>>
UC_DEPT ..> UC_LOGIN : <<include>>
UC_DOC ..> UC_LOGIN : <<include>>
UC_PAT ..> UC_LOGIN : <<include>>
UC_PDASH ..> UC_LOGIN : <<include>>
UC_ADASH ..> UC_LOGIN : <<include>>

@enduml
