@startuml CD_ForgotPassword
' Class Diagram – UC-4 Reset Forgotten Password
skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "CMU Sans Serif"
skinparam classFontSize 11
skinparam classFontStyle normal
skinparam nodesep 55
skinparam ranksep 55
hide circle

class ForgotPasswordPage {
  - email : String
  - errorMessage : String
  - successMessage : String
  --
  + handleChange(event : Event) : void
  + validateForm() : boolean
  + handleSubmit() : void
  + showError(message : String) : void
  + showSuccess(message : String) : void
}

class ResetPasswordPage {
  - token : String
  - newPassword : String
  - confirmPassword : String
  - errorMessage : String
  --
  + validateForm() : boolean
  + handleSubmit() : void
  + showError(message : String) : void
}

class AuthApiClient {
  --
  + forgotPassword(email : String) : Promise<MessageResponse>
  + resetPassword(token : String, newPassword : String) : Promise<MessageResponse>
}

class AuthController {
  - authService : AuthService
  --
  + forgotPassword(req : Request, res : Response) : void
  + resetPassword(req : Request, res : Response) : void
}

class AuthService {
  --
  + requestReset(email : String) : ResetResult
  + resetPassword(token : String, newPassword : String) : ResetResult
  + hashPassword(password : String) : String
}

class UserModel {
  - email : String
  - passwordHash : String
  - passwordChangedAt : Date
  --
  + findOne(filter : Object) : UserDocument
  + updateOne(filter : Object, update : Object) : void
}

class PasswordResetTokenModel {
  - userId : ObjectId
  - token : String
  - expiresAt : Date
  - usedAt : Date
  --
  + create(doc : Object) : PasswordResetTokenDocument
  + findOne(filter : Object) : PasswordResetTokenDocument
  + save() : void
}

class MailService {
  --
  + sendResetPasswordEmail(user : UserDocument, token : String) : void
}

ForgotPasswordPage -[hidden]r- ResetPasswordPage
ResetPasswordPage -[hidden]r- AuthApiClient
AuthApiClient -[hidden]r- AuthController
AuthController -[hidden]d- AuthService
AuthService -[hidden]d- UserModel
UserModel -[hidden]r- PasswordResetTokenModel
PasswordResetTokenModel -[hidden]r- MailService

ForgotPasswordPage "1" --> "1" AuthApiClient : uses
ResetPasswordPage "1" --> "1" AuthApiClient : uses
AuthApiClient "1" --> "1" AuthController : calls
AuthController "1" --> "1" AuthService : uses
AuthService "1" --> "1" UserModel : uses
AuthService "1" --> "0..*" PasswordResetTokenModel : creates
AuthService "1" --> "1" MailService : uses

@enduml
