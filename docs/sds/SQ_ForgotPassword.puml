@startuml SQ_ForgotPassword
' Sequence Diagram – UC-4 Reset Forgotten Password
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "CMU Sans Serif"
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true

actor User
participant ForgotPasswordPage as ForgotView
participant ResetPasswordPage as ResetView
participant AuthApiClient as Api
participant AuthController as Ctrl
participant AuthService as Svc
participant UserModel as UM
participant PasswordResetTokenModel as PRT
participant MailService as Mail
database MongoDB as DB

== Request reset link ==

User -> ForgotView ++ : 1. Enter registered email

ForgotView -> ForgotView : 2. validateForm()

ForgotView -> Api ++ : 3. forgotPassword(email)

Api -> Ctrl ++ : 4. POST /api/auth/forgot-password\n{ email }

Ctrl -> Svc ++ : 5. requestReset(email)

alt [1] Missing email

  Svc --> Ctrl -- : 6. HTTP 400
  Ctrl --> Api -- : 7. error response
  Api --> ForgotView -- : 8. error response
  ForgotView -> User : 9. showError(message)
  deactivate Svc
  deactivate Ctrl
  deactivate Api
  deactivate ForgotView

else [2] Email found (or neutral response)

  Svc -> UM ++ : 10. findOne({ email, isLocked: false })

  UM -> DB : 11. query users

  DB --> UM -- : 12. user / null

  UM --> Svc -- : 13. UserDocument
  deactivate UM

  Svc -> PRT ++ : 14. create({ userId, token, expiresAt })

  PRT -> DB : 15. insert emailTokens

  DB --> PRT -- : 16. ack

  PRT --> Svc -- : 17. token document
  deactivate PRT

  Svc -> Mail ++ : 18. sendResetPasswordEmail(user, token)

  Mail --> Svc -- : 19. void
  deactivate Mail

  Svc --> Ctrl -- : 20. HTTP 200\nneutral success message
  Ctrl --> Api -- : 21. success response
  Api --> ForgotView -- : 22. success response
  ForgotView -> User : 23. showSuccess(message)
  deactivate Svc
  deactivate Ctrl
  deactivate Api
  deactivate ForgotView

end

== Reset password ==

User -> ResetView ++ : 24. Open reset link\nEnter new password

ResetView -> ResetView : 25. validateForm()

ResetView -> Api ++ : 26. resetPassword(token, newPassword)

Api -> Ctrl ++ : 27. POST /api/auth/reset-password\n{ token, newPassword }

Ctrl -> Svc ++ : 28. resetPassword(token, newPassword)

alt [3] Invalid or expired token

  Svc -> PRT ++ : 29. findOne({ token, expiresAt, usedAt })

  PRT -> DB : 30. query emailTokens

  DB --> PRT -- : 31. null

  PRT --> Svc -- : 32. null
  deactivate PRT

  Svc --> Ctrl -- : 33. HTTP 400
  Ctrl --> Api -- : 34. error response
  Api --> ResetView -- : 35. error response
  ResetView -> User : 36. showError(message)
  deactivate Svc
  deactivate Ctrl
  deactivate Api
  deactivate ResetView

else [4] Valid token

  Svc -> Svc : 37. hashPassword(newPassword)

  Svc -> UM ++ : 38. updateOne({ _id }, { passwordHash })

  UM -> DB : 39. update users

  DB --> UM -- : 40. ack

  UM --> Svc -- : 41. void
  deactivate UM

  Svc -> PRT ++ : 42. save(usedAt)

  PRT -> DB : 43. update emailTokens

  DB --> PRT -- : 44. ack

  PRT --> Svc -- : 45. void
  deactivate PRT

  Svc --> Ctrl -- : 46. HTTP 200\n"Password updated"
  Ctrl --> Api -- : 47. success response
  Api --> ResetView -- : 48. success response
  ResetView -> User : 49. redirectToLogin()
  deactivate Svc
  deactivate Ctrl
  deactivate Api
  deactivate ResetView

end

@enduml
