@startuml SF14_PrescriptionHistory
title Screen Flow - View Prescription History (Patient)

skinparam rectangle {
  BackgroundColor #DAE8FC
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #FFF2CC
  BorderColor #333333
}
skinparam ArrowColor #444444

rectangle "Patient Dashboard" as Dash
rectangle "Prescription History" as List
rectangle "Prescription Detail\n(lines + QR tab)" as Detail
usecase "QR Code Popup" as QR

Dash --> List : Click "Prescriptions"\nmenu
List --> Detail : Click a row
Detail --> QR : Click "Show QR"\nbutton
Detail --> Detail : Click "Export PDF"\n(file download)

@enduml
