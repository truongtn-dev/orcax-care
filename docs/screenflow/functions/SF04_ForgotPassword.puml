@startuml SF04_ForgotPassword
title Screen Flow - Forgot Password

skinparam rectangle {
  BackgroundColor #DAE8FC
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #FFF2CC
  BorderColor #333333
}
skinparam ArrowColor #444444

rectangle "Login" as Login
rectangle "Forgot Password" as Forgot
rectangle "Reset Password" as Reset

Login --> Forgot : Click "Forgot\npassword?" link
Forgot --> Forgot : Submit email\n(neutral success message)
Forgot --> Reset : Open reset link\nfrom email
Reset --> Login : Password updated\nsuccessfully

@enduml
