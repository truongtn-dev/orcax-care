@startuml SF1_Guest
title Screen Flow of Guest

skinparam rectangle {
  BackgroundColor #DAE8FC
  BorderColor #333333
}
skinparam usecase {
  BackgroundColor #FFF2CC
  BorderColor #333333
}
skinparam ArrowColor #444444
skinparam nodesep 40
skinparam ranksep 50

rectangle "Portal Home" as Home
rectangle "Search Doctors" as Search
rectangle "Doctor Public Profile\n(info + reviews tab)" as Profile
rectangle "Branch Locator\n(list + map tab)" as Branch
rectangle "Register" as Register
rectangle "Email Verification" as Verify
rectangle "Login" as Login
rectangle "Forgot Password" as Forgot
rectangle "Reset Password" as Reset

Home --> Search : Click "Search Doctors"\nin header / search bar
Home --> Profile : Click a doctor card in\n"Featured Doctors" section
Search --> Profile : Click "View Profile"\non a result card
Home --> Branch : Click "Branches"\nin header
Home --> Register : Click "Register"\nbutton in header
Register --> Verify : Register\nsuccessfully
Verify --> Login : Click "Login" after\naccount activated
Home --> Login : Click "Login"\nbutton in header
Login --> Forgot : Click "Forgot\npassword?" link
Forgot --> Reset : Open reset link\nfrom email
Reset --> Login : Password updated
Profile --> Login : Click "Book Appointment"\n(login required)
Login --> Home : Login successfully\n(redirect by role)

legend left
  **Note:**
  * Screen: rectangle
  * Popup: oval
endlegend

@enduml
